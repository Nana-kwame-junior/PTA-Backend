# ── App ────────────────────────────────────────────────────────
PROJECT_NAME=PTA SaaS
API_BASE_URL=https://bizi.koyeb.app
# Base URL only — do NOT include /api/v1 (callback URL is built from this)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://user:pass@host/db?sslmode=require
DATABASE_URL_SYNC=postgresql+psycopg://user:pass@host/db?sslmode=require

# ── JWT ────────────────────────────────────────────────────────
JWT_SECRET=replace-with-64-char-hex-secret-no-quotes

# ── Paystack ───────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_your_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key
PAYSTACK_WEBHOOK_SECRET=your-webhook-secret

# ── Redis / Celery (optional locally) ──────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── CORS ───────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:3000

# ── Email (Gmail app password — staff invite / password reset) ─
MAIL_USERNAME=your@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_FROM=your@gmail.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=465
MAIL_SSL_TLS=True
MAIL_STARTTLS=False
MAIL_FROM_NAME=Mawuli PTA
# Legacy names also work: SMTP_USER, SMTP_PASS, SMTP_HOST, SMTP_PORT
