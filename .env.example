# ── App ────────────────────────────────────────────────────────
PROJECT_NAME=PTA SaaS
API_BASE_URL=https://bizi.koyeb.app
# Base URL only — do NOT include /api/v1 (callback URL is built from this)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://user:pass@host/db?sslmode=require
DATABASE_URL_SYNC=postgresql+psycopg://user:pass@host/db?sslmode=require

# ── JWT ────────────────────────────────────────────────────────
JWT_SECRET=replace-with-64-char-hex-secret-no-quotes

# ── Paystack ───────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_your_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key
PAYSTACK_WEBHOOK_SECRET=your-webhook-secret

# ── SMS (mNotify — all messages use SMS credits, not OTP wallet) ─
# https://developer.mnotify.com/#tag/SMS/operation/campaign/sms_quick
MNOTIFY_API_KEY=your_mnotify_api_key
MNOTIFY_SENDER_ID=MawuliPTA
SMS_DRY_RUN=false

# ── Redis / Celery (Upstash: use rediss://… — ssl_cert_reqs is added automatically) ─
REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR_HOST.upstash.io:6379
CELERY_BROKER_URL=rediss://default:YOUR_PASSWORD@YOUR_HOST.upstash.io:6379
CELERY_RESULT_BACKEND=rediss://default:YOUR_PASSWORD@YOUR_HOST.upstash.io:6379

# ── CORS ───────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:3000

# ── Cloudinary (announcement image uploads) ────────────────────
# Prefer a single URL: cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name
# Or set separately:
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# ── Email (Brevo — staff invite / password reset) ──────────────
# Create an API key: https://app.brevo.com/settings/keys/api
# Sender must be verified in Brevo: Settings → Senders & IPs
BREVO_API_KEY=xkeysib-your-brevo-api-key
# Either:
BREVO_FROM_EMAIL=SchoolPulse <noreply@yourdomain.com>
# Or separate fields:
# BREVO_SENDER_EMAIL=noreply@yourdomain.com
# BREVO_SENDER_NAME=SchoolPulse
